local function notify(text, kind)
    kind = kind or "info"
    local color = C.Accent
    if kind == "error" then color = Color3.fromRGB(255,60,60) end
    if kind == "warn" then color = Color3.fromRGB(255,184,0) end
    if kind == "info" then color = Color3.fromRGB(59,158,255) end

    local n = Instance.new("Frame")
