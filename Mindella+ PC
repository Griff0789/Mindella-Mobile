-- HELPERS
--=====================================================
local function alive(p)
    if not p or not p.Character then return false end
    local h = p.Character:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0
end
local function isTeammate(p)
    if p.Team and LP.Team then return p.Team == LP.Team end
    return false
end
local function getPart(p)
    if not alive(p) then return nil end
    return p.Character:FindFirstChild("Head")
        or p.Character:FindFirstChild("UpperTorso")
        or p.Character:FindFirstChild("Torso")
        or p.Character:FindFirstChild("HumanoidRootPart")
end
local function hrp()
    if LP.Character then return LP.Character:FindFirstChild("HumanoidRootPart") end
end
local function hum()
    if LP.Character then return LP.Character:FindFirstChildOfClass("Humanoid") end
end

