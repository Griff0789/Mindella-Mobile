local NR = {_lastCamCF=nil, _hookInstalled=false}

local function nrKillValues()
    if not C.NoRecoilValues then return end
    local char = LP.Character
    if not char then return end
    local containers = {char}
    if LP:FindFirstChild("Backpack") then table.insert(containers, LP.Backpack) end
    for _, cont in ipairs(containers) do
        for _, tool in ipairs(cont:GetChildren()) do
            if tool:IsA("Tool") then
                for _, obj in ipairs(tool:GetDescendants()) do
                    if obj:IsA("NumberValue") or obj:IsA("IntValue") then
                        local n = obj.Name:lower()
                        if n:find("recoil") or n:find("spread") or n:find("kick") then
                            obj.Value = 0
                        end
                    end
                end
            end
        end
    end
end

local function nrCamera()
    if not C.NoRecoilCamera then return end
    local c = Camera.CFrame
    if not NR._lastCamCF then NR._lastCamCF = c; return end
    local dy = c.LookVector.Y - NR._lastCamCF.LookVector.Y
    if dy > 0.003 and dy < 0.2 then
        Camera.CFrame = c * CFrame.Angles(math.rad(-math.deg(math.asin(dy)) * 0.85), 0, 0)
    end
    NR._lastCamCF = Camera.CFrame
end

local function nrMouse()
    if not C.NoRecoilMouse or not ENV.mouse then return end
    if not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then return end
    local d = UIS:GetMouseDelta()
    if d.Y > 0 and d.Y < 50 then pcall(mousemoverel, 0, d.Y * 0.9) end
end

