local catButtons = {}
local currentTab = nil

local function createTabButton(name)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, 0, 0, 28)
    b.BackgroundColor3 = C.PanelHi
    b.BackgroundTransparency = 1
    b.Text = "   " .. name
    b.TextColor3 = C.TxtSub
    b.Font = Enum.Font.Gotham
    b.TextSize = 11
    b.TextXAlignment = Enum.TextXAlignment.Left
    b.BorderSizePixel = 0
    b.AutoButtonColor = false
    b.ZIndex = 4
    b.Parent = sidebar
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)

    b.MouseEnter:Connect(function()
        if currentTab == name then return end
        TweenService:Create(b, TweenInfo.new(0.15), {BackgroundColor3=C.Accent, BackgroundTransparency=0.75, TextColor3=C.Txt}):Play()
    end)
    b.MouseLeave:Connect(function()
        if currentTab == name then return end
        TweenService:Create(b, TweenInfo.new(0.15), {BackgroundColor3=C.PanelHi, BackgroundTransparency=1, TextColor3=C.TxtSub}):Play()
    end)

    b.MouseButton1Click:Connect(function()
        currentTab = name
        for n, bb in pairs(tabButtons) do
            TweenService:Create(bb, TweenInfo.new(0.15), {BackgroundColor3=C.PanelHi, BackgroundTransparency=1, TextColor3=C.TxtSub}):Play()
        end
        TweenService:Create(b, TweenInfo.new(0.15), {BackgroundColor3=C.PanelHi, BackgroundTransparency=0, TextColor3=C.Accent}):Play()
        for n, cat in pairs(pages) do
            for cn, page in pairs(cat) do
                page.Visible = false
            end
        end
        -- создаём категории для вкладки
        for _, c in ipairs(catBar:GetChildren()) do
            if c:IsA("TextButton") then c:Destroy() end
        end
        catButtons = {}
        if pages[name] then
            for catName, _ in pairs(pages[name]) do
                local cb = Instance.new("TextButton")
                cb.Size = UDim2.new(0, 100, 0, 24)
                cb.BackgroundColor3 = C.PanelHi
                cb.BackgroundTransparency = 0.5
                cb.Text = catName
                cb.TextColor3 = C.TxtSub
                cb.Font = Enum.Font.Gotham
                cb.TextSize = 11
                cb.BorderSizePixel = 0
                cb.AutoButtonColor = false
                cb.ZIndex = 5
                cb.Parent = catBar
                Instance.new("UICorner", cb).CornerRadius = UDim.new(0, 4)

                cb.MouseEnter:Connect(function()
                    if cb:GetAttribute("Active") then return end
                    TweenService:Create(cb, TweenInfo.new(0.12), {BackgroundColor3=C.Accent, BackgroundTransparency=0.7, TextColor3=C.Txt}):Play()
                end)
                cb.MouseLeave:Connect(function()
                    if cb:GetAttribute("Active") then return end
                    TweenService:Create(cb, TweenInfo.new(0.12), {BackgroundColor3=C.PanelHi, BackgroundTransparency=0.5, TextColor3=C.TxtSub}):Play()
                end)

                cb.MouseButton1Click:Connect(function()
                    for _, c2 in ipairs(catBar:GetChildren()) do
                        if c2:IsA("TextButton") then
                            c2:SetAttribute("Active", false)
                            TweenService:Create(c2, TweenInfo.new(0.12), {BackgroundColor3=C.PanelHi, BackgroundTransparency=0.5, TextColor3=C.TxtSub}):Play()
                        end
                    end
                    cb:SetAttribute("Active", true)
                    TweenService:Create(cb, TweenInfo.new(0.15), {BackgroundColor3=C.Accent, BackgroundTransparency=0.2, TextColor3=C.BG}):Play()
                    for n, cat in pairs(pages) do
                        for cn, page in pairs(cat) do
                            page.Visible = false
                        end
                    end
                    if pages[name][catName] then
                        pages[name][catName].Visible = true
                    end
                end)

                catButtons[catName] = cb
            end
            -- открываем первую категорию
            local first
            for cname, _ in pairs(pages[name]) do first = cname; break end
            if first then
                for _, c2 in ipairs(catBar:GetChildren()) do
                    if c2:IsA("TextButton") and c2.Text == first then
                        c2:SetAttribute("Active", true)
                        TweenService:Create(c2, TweenInfo.new(0.15), {BackgroundColor3=C.Accent, BackgroundTransparency=0.2, TextColor3=C.BG}):Play()
                    end
                end
                pages[name][first].Visible = true
            end
        end
    end)

    tabButtons[name] = b
end

