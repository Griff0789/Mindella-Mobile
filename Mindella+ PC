local Trig = {_last=0}

local function checkMouseTrig()
    local mp = UIS:GetMouseLocation()
    local ray = Camera:ViewportPointToRay(mp.X, mp.Y)
    local hit = Workspace:FindPartOnRayWithIgnoreList(Ray.new(ray.Origin, ray.Direction*1000), {LP.Character, Camera})
    if not hit or not hit.Parent then return false end
    local plr = Players:GetPlayerFromCharacter(hit.Parent)
    if not plr or plr == LP or not alive(plr) then return false end
    if C.TrigTeam and isTeammate(plr) then return false end
    if C.TrigHeadOnly and hit.Name ~= "Head" then return false end
    return true
end

local function checkCenterTrig()
    local cx = Camera.ViewportSize.X / 2
    local cy = Camera.ViewportSize.Y / 2
    local camPos = Camera.CFrame.Position
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP or not alive(plr) or (C.TrigTeam and isTeammate(plr)) then continue end
        local root = plr.Character:FindFirstChild("HumanoidRootPart")
        if root and (root.Position - camPos).Magnitude <= C.TrigDistance then
            for _, part in ipairs(plr.Character:GetChildren()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    if not C.TrigHeadOnly or part.Name == "Head" then
                        local sp, on = Camera:WorldToViewportPoint(part.Position)
                        if on then
                            local dx, dy = sp.X - cx, sp.Y - cy
                            if math.sqrt(dx*dx + dy*dy) <= C.TrigCenterRadius then
                                return true
                            end
                        end
                    end
                end
            end
        end
    end
    return false
end

RunService.RenderStepped:Connect(function()
    if not C.Trig then return end
    if C.TrigMouseEnabled and tick() - Trig._last >= C.TrigMouseDelay then
        if checkMouseTrig() and math.random(1,100) <= C.TrigChance then
            Trig._last = tick()
            if ENV.click then mouse1click() end
            return
        end
    end
    if C.TrigStableEnabled and tick() - Trig._last >= C.TrigStableDelay then
        if checkCenterTrig() and math.random(1,100) <= C.TrigChance then
            Trig._last = tick()
            if ENV.click then mouse1click() end
        end
    end
end)

