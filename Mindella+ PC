    if TP._yaw > math.pi then TP._yaw = TP._yaw - 2*math.pi end
    if TP._yaw < -math.pi then TP._yaw = TP._yaw + 2*math.pi end
    TP._pitch = math.clamp(TP._pitch, math.rad(-70), math.rad(70))
    local offset = Vector3.new(0, C.ThirdPersonHeight, C.ThirdPersonDistance)
    local yaw, pitch = TP._yaw, TP._pitch
    local lookCF = CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
    local rotated = CFrame.Angles(0, yaw, 0) * offset
    local tPos = root.Position + rotated
    local lookAt = root.Position + Vector3.new(0, 1.5, 0)
    local tCF = CFrame.new(tPos, lookAt) * lookCF
    if C.ThirdPersonSmooth then
        if not TP._cur then TP._cur = tCF end
        TP._cur = TP._cur:Lerp(tCF, math.min(1, 15 * dt))
        Camera.CFrame = TP._cur
    else
        TP._cur = tCF
        Camera.CFrame = tCF
    end
end

