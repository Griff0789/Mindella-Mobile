local A360 = {_target=nil, _last=0, _shots=0, _spinWas=false, _spinPaused=false}
local function a360Alive(t)
    if not t or not t.Parent or not t.Character or not t.Character.Parent then return false end
    local h = t.Character:FindFirstChildOfClass("Humanoid")
    if not h or h.Health <= 0 then return false end
    if not t.Character:FindFirstChild("Head") then return false end
    return true
end

RunService.Heartbeat:Connect(function()
    if not C.Auto360Enabled then
        A360._target = nil; A360._shots = 0
        if A360._spinPaused then C.Spin = A360._spinWas; A360._spinPaused = false end
        return
    end
    if not a360Alive(A360._target) then
        local best, bestDist = nil, C.Auto360Radius
        local camPos = Camera.CFrame.Position
        for _, p in ipairs(Players:GetPlayers()) do
            if p == LP or (C.AimTeam and isTeammate(p)) or not alive(p) then continue end
            local head = p.Character:FindFirstChild("Head")
            local root = p.Character:FindFirstChild("HumanoidRootPart")
            if not head or not root then continue end
            local dist = (root.Position - camPos).Magnitude
            if dist > bestDist then continue end
            if C.AimVisible then
                local r = Ray.new(camPos, head.Position - camPos)
                local hit = Workspace:FindPartOnRayWithIgnoreList(r, {LP.Character, Camera})
                if hit ~= head and not (hit and hit:IsDescendantOf(head.Parent)) then continue end
            end
            if dist < bestDist then bestDist = dist; best = p end
        end
        A360._target = best
        A360._shots = 0
        if not A360._target then
            if A360._spinPaused then C.Spin = A360._spinWas; A360._spinPaused = false end
            return
        end
    end
    local pauseSpin = C.Auto360SpinMode == "Full" or
        (C.Auto360SpinMode == "ShotOnly" and (tick() - A360._last < 0.1))
    if pauseSpin and C.Spin and not A360._spinPaused then
        A360._spinWas = true; A360._spinPaused = true; C.Spin = false
    elseif not pauseSpin and A360._spinPaused then
        C.Spin = A360._spinWas; A360._spinPaused = false
    end
    if C.Auto360TurnBody then
        local tr = A360._target.Character and A360._target.Character:FindFirstChild("HumanoidRootPart")
        local r = hrp()
        if tr and r then
            local d = tr.Position - r.Position
            local flat = Vector3.new(d.X, 0, d.Z)
            if flat.Magnitude > 0.1 then
                local yaw = math.atan2(-flat.X, -flat.Z)
                r.CFrame = CFrame.new(r.Position) * CFrame.Angles(0, yaw, 0)
            end
        end
    end
    local head = A360._target.Character:FindFirstChild("Head")
    if head then aimTarget = head; silentTarget = head end
    if C.Auto360AutoShoot then
        if tick() - A360._last < C.Auto360FireRate then return end
        if A360._shots >= C.Auto360MaxShots then
            if not a360Alive(A360._target) then A360._target = nil; A360._shots = 0
            else A360._shots = 0; task.wait(0.3) end
            return
        end
        A360._last = tick()
        A360._shots = A360._shots + 1
        if ENV.click then mouse1click() end
    end
end)

