local espCache = {}

local function mkESP(plr)
    if espCache[plr] then return espCache[plr] end
    local data = {}
    if ENV.draw then
        local box = Drawing.new("Square")
        box.Thickness = 1.5; box.Filled = false; box.Visible = false
        data.box = box
        local nm = Drawing.new("Text")
        nm.Size = C.EspTextSize; nm.Center = true; nm.Outline = true; nm.Visible = false
        data.name = nm
        local hp = Drawing.new("Text")
        hp.Size = C.EspTextSize - 2; hp.Center = true; hp.Outline = true; hp.Visible = false
        data.hp = hp
        local ds = Drawing.new("Text")
        ds.Size = C.EspTextSize - 2; ds.Center = true; ds.Outline = true; ds.Visible = false
        data.dist = ds
        local tr = Drawing.new("Line")
        tr.Thickness = 1; tr.Visible = false
        data.tracer = tr
        data.skel = {}
        for i = 1, 20 do
            local l = Drawing.new("Line"); l.Thickness = 1; l.Visible = false
            table.insert(data.skel, l)
        end
    end
    espCache[plr] = data
    return data
end

local function rmESP(plr)
    local d = espCache[plr]
    if not d then return end
    if d.box then pcall(function() d.box:Remove() end) end
    if d.name then pcall(function() d.name:Remove() end) end
    if d.hp then pcall(function() d.hp:Remove() end) end
    if d.dist then pcall(function() d.dist:Remove() end) end
    if d.tracer then pcall(function() d.tracer:Remove() end) end
    if d.skel then for _, l in ipairs(d.skel) do pcall(function() l:Remove() end) end end
    espCache[plr] = nil
end

Players.PlayerRemoving:Connect(rmESP)

local function espSkelPairs(char)
    local pairs = {}
    local function try(n) return char:FindFirstChild(n) end
    local head, ut, lt = try("Head"), try("UpperTorso"), try("LowerTorso")
    if head and ut then
        table.insert(pairs, {head, ut})
        local lua, lla, lh = try("LeftUpperArm"), try("LeftLowerArm"), try("LeftHand")
        local rua, rla, rh = try("RightUpperArm"), try("RightLowerArm"), try("RightHand")
        if lua then table.insert(pairs, {ut, lua}) end
        if lla then table.insert(pairs, {lua, lla}) end
        if lh then table.insert(pairs, {lla, lh}) end
        if rua then table.insert(pairs, {ut, rua}) end
        if rla then table.insert(pairs, {rua, rla}) end
        if rh then table.insert(pairs, {rla, rh}) end
        if lt then
            table.insert(pairs, {ut, lt})
            local lul, lll, lf = try("LeftUpperLeg"), try("LeftLowerLeg"), try("LeftFoot")
            local rul, rll, rf = try("RightUpperLeg"), try("RightLowerLeg"), try("RightFoot")
            if lul then table.insert(pairs, {lt, lul}) end
            if lll then table.insert(pairs, {lul, lll}) end
            if lf then table.insert(pairs, {lll, lf}) end
            if rul then table.insert(pairs, {lt, rul}) end
            if rll then table.insert(pairs, {rul, rll}) end
            if rf then table.insert(pairs, {rll, rf}) end
        end
        return pairs
    end
    local torso, la, ra, ll, rl = try("Torso"), try("Left Arm"), try("Right Arm"), try("Left Leg"), try("Right Leg")
    if head and torso then
        table.insert(pairs, {head, torso})
        if la then table.insert(pairs, {torso, la}) end
        if ra then table.insert(pairs, {torso, ra}) end
        if ll then table.insert(pairs, {torso, ll}) end
        if rl then table.insert(pairs, {torso, rl}) end
    end
    return pairs
end

