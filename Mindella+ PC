--=====================================================
-- CROSS MARKER
--=====================================================
if ENV.draw then
    local MAX = 60
    local weakPool = {}
    for i=1,MAX do
        local slot = {
            line1=Drawing.new("Line"), line2=Drawing.new("Line"),
            line3=Drawing.new("Line"), line4=Drawing.new("Line"),
            circle=Drawing.new("Circle"), angle=0,
        }
        for _, l in ipairs({slot.line1, slot.line2, slot.line3, slot.line4}) do
            l.Thickness=2; l.Visible=false; l.Transparency=1; l.Color=C.CrossColor
        end
        slot.circle.Thickness=2; slot.circle.NumSides=40; slot.circle.Transparency=1
        slot.circle.Color=C.CrossColor; slot.circle.Visible=false; slot.circle.Filled=false
        weakPool[i] = slot
    end

    local aimSlot = {
        line1=Drawing.new("Line"), line2=Drawing.new("Line"),
        line3=Drawing.new("Line"), line4=Drawing.new("Line"),
        circle=Drawing.new("Circle"), angle=0, lastX=0, lastY=0, hasLast=false,
    }
    for _, l in ipairs({aimSlot.line1, aimSlot.line2, aimSlot.line3, aimSlot.line4}) do
        l.Thickness=3; l.Visible=false; l.Transparency=1; l.Color=C.CrossAimColor
    end
    aimSlot.circle.Thickness=3; aimSlot.circle.NumSides=40; aimSlot.circle.Transparency=1
    aimSlot.circle.Color=C.CrossAimColor; aimSlot.circle.Visible=false; aimSlot.circle.Filled=false

    local function hideSlot(s)
        s.line1.Visible=false; s.line2.Visible=false
        s.line3.Visible=false; s.line4.Visible=false; s.circle.Visible=false
    end

    local function drawCross(s, cx, cy, size, angle, color, thick)
        for i=1,4 do
            local a = angle + math.rad(90*(i-1))
            local x1 = cx + math.cos(a)*size; local y1 = cy + math.sin(a)*size
            local x2 = cx - math.cos(a)*size; local y2 = cy - math.sin(a)*size
            local l = s["line"..i]
            l.From=Vector2.new(x1,y1); l.To=Vector2.new(x2,y2)
            l.Color=color; l.Thickness=thick; l.Visible=true
        end
        s.circle.Visible=false
    end

    local function drawSquare(s, cx, cy, size, angle, color, thick)
        local corners = {}
        for i=0,3 do
            local a = angle + math.rad(90*i + 45)
            corners[i+1] = Vector2.new(cx + math.cos(a)*size, cy + math.sin(a)*size)
        end
        for i=1,4 do
            local l = s["line"..i]
            l.From = corners[i]; l.To = corners[i%4+1]
            l.Color=color; l.Thickness=thick; l.Visible=true
        end
        s.circle.Visible=false
    end

    local function drawCircle(s, cx, cy, size, angle, color, thick, filled, seg)
        hideSlot(s)
        s.circle.Position = Vector2.new(cx, cy)
        s.circle.Radius = size
        s.circle.Color = color
        s.circle.Thickness = thick
        s.circle.NumSides = math.clamp(seg or 40, 8, 80)
        s.circle.Filled = filled or false
        s.circle.Visible = true
    end

    local function drawShape(s, shape, cx, cy, size, angle, color, thick, filled, seg)
        if shape == "Cross" then drawCross(s, cx, cy, size, angle, color, thick)
        elseif shape == "Square" then drawSquare(s, cx, cy, size, angle, color, thick)
        elseif shape == "Circle" then drawCircle(s, cx, cy, size, angle, color, thick, filled, seg) end
    end

    local fc = 0
    RunService.RenderStepped:Connect(function(dt)
        fc = fc + 1
        if C.CrossAimSpin then aimSlot.angle = aimSlot.angle + C.CrossAimSpinSpeed * dt end

        if fc % 2 == 0 then
            if C.CrossSpin then
                for i=1,MAX do weakPool[i].angle = weakPool[i].angle + C.CrossSpinSpeed * dt * 2 end
            end
            if C.CrossEnabled then
                local idx = 1
                local camPos = Camera.CFrame.Position
                for _, p in ipairs(Players:GetPlayers()) do
                    if p == LP or idx > MAX then continue end
                    local char = p.Character
                    if not char then continue end
                    local head = char:FindFirstChild("Head")
                    if not head then continue end
                    local h = char:FindFirstChildOfClass("Humanoid")
                    if not h or h.Health <= 0 then continue end
                    local dist = (head.Position - camPos).Magnitude
                    if dist > C.CrossRadius then continue end
                    local sp, on = Camera:WorldToViewportPoint(head.Position + Vector3.new(0,1.5,0))
                    if not on then continue end
                    drawShape(weakPool[idx], C.CrossShape, sp.X, sp.Y, C.CrossSize, weakPool[idx].angle,
                        C.CrossColor, C.CrossThickness, C.CrossFill, C.CrossSegments)
                    idx = idx + 1
                end
                for i=idx,MAX do hideSlot(weakPool[i]) end
            else
                for i=1,MAX do hideSlot(weakPool[i]) end
            end
        end

        if C.CrossShowAim and C.Aim and aimTarget and aimTarget.Parent then
            local pos, on = Camera:WorldToViewportPoint(aimTarget.Position)
            if on then
                local tx, ty = pos.X, pos.Y
                if C.CrossAimSmooth then
                    if not aimSlot.hasLast then
                        aimSlot.lastX = tx; aimSlot.lastY = ty; aimSlot.hasLast = true
                    end
                    local k = math.min(1, C.CrossAimSmoothSpeed * dt)
                    aimSlot.lastX = aimSlot.lastX + (tx - aimSlot.lastX) * k
                    aimSlot.lastY = aimSlot.lastY + (ty - aimSlot.lastY) * k
                else
                    aimSlot.lastX = tx; aimSlot.lastY = ty; aimSlot.hasLast = true
                end
                drawShape(aimSlot, C.CrossAimShape, aimSlot.lastX, aimSlot.lastY,
                    C.CrossAimSize, aimSlot.angle, C.CrossAimColor, C.CrossAimThickness,
                    C.CrossAimFill, C.CrossAimSegments)
            else hideSlot(aimSlot); aimSlot.hasLast=false end
        else hideSlot(aimSlot); aimSlot.hasLast=false end
    end)
end

