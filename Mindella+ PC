    lbl.TextColor3 = C.Txt
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex = 101
    lbl.Parent = n

    TweenService:Create(n, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        {Position=UDim2.new(0.5,-160,0,16)}):Play()
    task.spawn(function()
        task.wait(3)
        local t = TweenService:Create(n, TweenInfo.new(0.3), {Position=UDim2.new(0.5,-160,-0.1,0)})
        t:Play(); t.Completed:Wait(); n:Destroy()
    end)
end

