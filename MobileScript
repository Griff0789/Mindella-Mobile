local currentModel = nil
local currentSkinName = nil
local templateCache = {}
local originalVisuals = setmetatable({}, {__mode = "k"})

local function setCharVis(char, visible)
    if not char then return end
    for _, inst in ipairs(char:GetDescendants()) do
        if inst:IsA("BasePart") then
            if not visible then
                if not originalVisuals[inst] then
                    originalVisuals[inst] = {T=inst.Transparency, L=inst.LocalTransparencyModifier}
                end
                inst.Transparency = 1
                inst.LocalTransparencyModifier = 1
            else
                local o = originalVisuals[inst]
                if o then
                    inst.Transparency = o.T
                    inst.LocalTransparencyModifier = o.L
                    originalVisuals[inst] = nil
                end
            end
        elseif inst:IsA("Decal") or inst:IsA("Texture") then
            if not visible then
                if not originalVisuals[inst] then originalVisuals[inst] = {T=inst.Transparency} end
                inst.Transparency = 1
            else
                local o = originalVisuals[inst]
                if o then inst.Transparency = o.T; originalVisuals[inst] = nil end
            end
        end
    end
end

local function normalizeModel(raw)
    if not raw then return nil end
    if raw:IsA("Model") then return raw end
    local nested = raw:FindFirstChildWhichIsA("Model", true)
    if nested then nested.Parent = nil; raw:Destroy(); return nested end
    if raw:IsA("Tool") or raw:IsA("Accessory") then
        local handle = raw:FindFirstChild("Handle")
        if handle then
            local wrap = Instance.new("Model")
            handle.Parent = wrap
            wrap.PrimaryPart = handle
            raw:Destroy()
            return wrap
        end
    end
    if raw:IsA("BasePart") then
        local wrap = Instance.new("Model")
        raw.Parent = wrap
        wrap.PrimaryPart = raw
        return wrap
    end
    return nil
end

local function loadTemplate(name, assetId)
    if templateCache[name] then return templateCache[name] end
    local objects
    local ok, result = pcall(function() return game:GetObjects("rbxassetid://" .. tostring(assetId)) end)
    if ok and result and #result > 0 then
        objects = result
    else
        local okIns, inserted = pcall(function()
            return game:GetService("InsertService"):LoadAsset(assetId)
        end)
        if okIns and inserted then objects = {inserted} end
    end
    if not objects then return nil end
    local tpl = normalizeModel(objects[1])
    if not tpl then return nil end
    for _, inst in ipairs(tpl:GetDescendants()) do
        if inst:IsA("Humanoid") or inst:IsA("Animator") or inst:IsA("AnimationController")
            or inst:IsA("Script") or inst:IsA("LocalScript") or inst:IsA("BodyMover") then
            inst:Destroy()
        elseif inst:IsA("BasePart") then
            inst.CanCollide = false
            inst.CanQuery = false
            inst.CanTouch = false
            inst.Anchored = true
            inst.Massless = true
        end
    end
    if not tpl.PrimaryPart then
        tpl.PrimaryPart = tpl:FindFirstChild("HumanoidRootPart", true)
            or tpl:FindFirstChild("Torso", true)
            or tpl:FindFirstChildWhichIsA("BasePart", true)
    end
    if not tpl.PrimaryPart then tpl:Destroy(); return nil end
    tpl.Parent = nil
    templateCache[name] = tpl
    return tpl
end

function clearSkin(keep)
    if currentModel then pcall(function() currentModel:Destroy() end); currentModel = nil end
    setCharVis(LP.Character, true)
    if not keep then currentSkinName = nil end
end

function applySkin(name)
    local config = skinConfigs[name]
    if not config then return end
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not char or not root then return end

    local tpl = loadTemplate(name, config.assetId)
    if not tpl then
        print("[Mindella Mobile] Skin load failed: " .. name)
        return
    end

    clearSkin(true)
    config.scale = C.SkinScale or config.scale or 1
    config.yOffset = C.SkinYOffset or config.yOffset or 0

    local clone = tpl:Clone()
    clone.Name = "MindellaMobSkin_" .. name
    pcall(function() clone:ScaleTo(config.scale or 1) end)
    clone.Parent = Workspace
    pcall(function() clone:PivotTo(root.CFrame * CFrame.new(0, config.yOffset or 0, 0)) end)
    setCharVis(char, false)
    currentModel = clone
    currentSkinName = name
    print("[Mindella Mobile] Skin applied: " .. name)
end

function setSkinScale(v)
    C.SkinScale = v
    if currentSkinName and skinConfigs[currentSkinName] then
        skinConfigs[currentSkinName].scale = v
    end
    if currentModel then pcall(function() currentModel:ScaleTo(v) end) end
end

function updateSkinModel()
    if not currentModel then return end
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local config = currentSkinName and skinConfigs[currentSkinName]
    if not root or not config or not currentModel.Parent then
        clearSkin(true)
        return
    end
    pcall(function()
        currentModel:PivotTo(root.CFrame * CFrame.new(0, config.yOffset or 0, 0))
    end)
end

