local currentTab = nil

local function createTabButton(name)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, 0, 0, 36)
    b.BackgroundColor3 = C.PanelHi
    b.BackgroundTransparency = 1
    b.Text = "  " .. name
    b.TextColor3 = C.TxtSub
    b.Font = Enum.Font.GothamBold
    b.TextSize = 12
    b.TextXAlignment = Enum.TextXAlignment.Left
    b.BorderSizePixel = 0
    b.AutoButtonColor = false
    b.ZIndex = 102
    b.Parent = sidebar
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)

    b.MouseButton1Click:Connect(function()
        currentTab = name
        for n, bb in pairs(tabButtons) do
            TweenService:Create(bb, TweenInfo.new(0.15), {BackgroundColor3=C.PanelHi, BackgroundTransparency=1, TextColor3=C.TxtSub}):Play()
        end
        TweenService:Create(b, TweenInfo.new(0.15), {BackgroundColor3=C.PanelHi, BackgroundTransparency=0, TextColor3=C.Accent}):Play()
        for n, page in pairs(pages) do
            page.Visible = false
        end
        if pages[name] then
            pages[name].Visible = true
            task.wait(0.05)
            local layout = pages[name]:FindFirstChildOfClass("UIListLayout")
            if layout then
                pages[name].CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 40)
            end
            pages[name].CanvasPosition = Vector2.new(0, 0)
        end
    end)

    tabButtons[name] = b
end

local function createPage()
    local page = Instance.new("ScrollingFrame")
    page.Size = UDim2.new(1, -10, 1, -10)
    page.Position = UDim2.new(0, 5, 0, 5)
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.ScrollBarThickness = 8
    page.ScrollBarImageColor3 = C.Accent
    page.CanvasSize = UDim2.new(0, 0, 0, 0)
    page.Visible = false
    page.ZIndex = 102
    page.Parent = content

    pcall(function()
        page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    end)
    pcall(function()
        page.ElasticBehavior = Enum.ElasticBehavior.Always
    end)

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 8)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = page

    local pad = Instance.new("UIPadding")
    pad.PaddingBottom = UDim.new(0, 30)
    pad.PaddingTop = UDim.new(0, 4)
    pad.Parent = page

    local function recalc()
        local abs = layout.AbsoluteContentSize
        page.CanvasSize = UDim2.new(0, 0, 0, abs.Y + 40)
    end

    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(recalc)
    page.ChildAdded:Connect(function() task.wait(0.05); recalc() end)
    page.ChildRemoved:Connect(function() task.wait(0.05); recalc() end)

    task.spawn(function()
        while page.Parent do
            task.wait(0.5)
            recalc()
        end
    end)

    return page
end

