local aimTarget = nil

local function closestTarget(fov)
    local best, bd = nil, fov or C.AimFOV
    local vp = Camera.ViewportSize
    local centerX, centerY = vp.X * 0.5, vp.Y * 0.5
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP or (C.AimTeam and isTeammate(p)) or not alive(p) then continue end
        local part = getPart(p)
        if part then
            local sp, on = Camera:WorldToViewportPoint(part.Position)
            if on then
                local d = (Vector2.new(sp.X, sp.Y) - Vector2.new(centerX, centerY)).Magnitude
                if d < bd then bd = d; best = part end
            end
        end
    end
    return best
end

RunService.RenderStepped:Connect(function()
    if not C.Aim then aimTarget = nil; return end
    if not C.Aim360 then
        local t = closestTarget(C.AimFOV)
        aimTarget = t
        if t then
            Camera.CFrame = Camera.CFrame:Lerp(
                CFrame.new(Camera.CFrame.Position, t.Position),
                1 - C.AimSmooth
            )
        end
    end
end)

