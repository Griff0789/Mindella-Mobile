local function calculateBox(cam, hrp)
    local screen, onScreen = cam:WorldToViewportPoint(hrp.Position)
    if screen.Z <= 1 then return nil end
    local vp = cam.ViewportSize
    if not onScreen and (screen.X < -80 or screen.X > vp.X + 80 or screen.Y < -80 or screen.Y > vp.Y + 80) then
        return nil
    end
    local proj = vp.Y / (2 * math.tan(math.rad(cam.FieldOfView) * 0.5))
    local height = math.clamp((7.0 * proj) / screen.Z, 5, vp.Y * 0.82)
    local width = math.max(height * 0.60, 3)
    return screen.X - width * 0.5, screen.Y - height * 0.52, width, height
end

RunService.RenderStepped:Connect(function()
    if not C.Esp then
        for _, d in pairs(espCache) do hideESP(d) end
        return
    end
    local cam = Workspace.CurrentCamera
    local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not cam or not myRoot then return end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local d = espCache[plr]
            if C.EspTeamCheck and isTeammate(plr) then
                if d then hideESP(d) end
            else
                local ch = plr.Character
                local hrp2 = ch and ch:FindFirstChild("HumanoidRootPart")
                local h = ch and ch:FindFirstChildOfClass("Humanoid")
                if ch and hrp2 and h and h.Health > 0 then
                    local distance = (myRoot.Position - hrp2.Position).Magnitude
                    if distance <= C.EspMaxDist then
                        local x, y, w, hh = calculateBox(cam, hrp2)
                        if x then
                            if not d then d = mkESP(plr) end
                            d.Holder.Visible = true
                            d.Holder.Position = UDim2.fromOffset(math.floor(x), math.floor(y))
                            d.Holder.Size = UDim2.fromOffset(math.floor(w), math.floor(hh))

                            local boxColor = C.EspBoxColor
                            local gradTop = C.EspGradientTop
                            local gradBottom = C.EspGradientBottom

                            d.Glow.ImageTransparency = C.EspBoxGlow and 0.25 or 1
                            d.GlowGrad.Color = ColorSequence.new(C.EspGlowTop, C.EspGlowBottom)

                            d.Fill.Visible = C.EspFilled
                            d.FillGrad.Color = ColorSequence.new(C.EspFillTop, C.EspFillBottom)

                            d.Box.Visible = C.EspBox
                            d.Outer.Color = boxColor
                            d.Inline.Visible = C.EspBox
                            d.BoxGrad.Color = ColorSequence.new(gradTop, gradBottom)

                            d.Name.Visible = C.EspName
                            d.Name.Text = plr.DisplayName

                            d.Dist.Visible = C.EspDist
                            d.Dist.Text = math.floor(distance) .. "st"

                            d.Weapon.Visible = C.EspWeapon
                            d.Weapon.Text = getWeapon(plr)

                            local state = h:GetState()
                            local flags = {}
                            if C.EspWalking and h.MoveDirection.Magnitude > 0 then flags[#flags+1] = "Walking" end
                            if C.EspJumping and (state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall) then flags[#flags+1] = "Jumping" end
                            if C.EspSwimming and state == Enum.HumanoidStateType.Swimming then flags[#flags+1] = "Swimming" end
                            d.Flags.RichText = true
                            d.Flags.Text = table.concat(flags, "\n")
                            d.Flags.Visible = #flags > 0

                            d.HpBg.Visible = C.EspHealthBar
                            if C.EspHealthBar then
                                local ratio = math.clamp(h.Health / math.max(h.MaxHealth, 1), 0, 1)
                                d.Hp.Size = UDim2.new(1, 0, ratio, 0)
                            end

                            if C.EspChams then
                                if not d.Chams or not d.Chams.Parent then
                                    local hl = Instance.new("Highlight")
                                    hl.Name = "MindellaMobChams"
                                    hl.Adornee = ch
                                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                                    hl.FillTransparency = 0.62
                                    hl.OutlineTransparency = 0.12
                                    hl.Parent = ch
                                    d.Chams = hl
                                end
                                local st = math.clamp(C.EspChamsStrength / 100, 0, 1)
                                d.Chams.FillTransparency = 1 - st
                                d.Chams.OutlineTransparency = 1 - math.clamp(st * 1.25, 0, 1)
                                d.Chams.FillColor = boxColor
                                d.Chams.OutlineColor = gradTop
                            elseif d.Chams then
                                d.Chams:Destroy()
                                d.Chams = nil
                            end
                        end
                    else
                        if d then hideESP(d) end
                    end
                else
                    if d then hideESP(d) end
                end
            end
        end
    end
end)

