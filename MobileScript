local A360 = {_target=nil, _last=0, _shots=0}
local function a360Alive(t)
    if not t or not t.Parent or not t.Character then return false end
    local h = t.Character:FindFirstChildOfClass("Humanoid")
    if not h or h.Health <= 0 then return false end
    return true
end

RunService.Heartbeat:Connect(function()
    if not C.Auto360Enabled then return end
    if not a360Alive(A360._target) then
        local best, bd = nil, C.Auto360Radius
        local camPos = Camera.CFrame.Position
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and not (C.AimTeam and isTeammate(p)) and alive(p) then
                local root = p.Character:FindFirstChild("HumanoidRootPart")
                if root then
                    local d = (root.Position - camPos).Magnitude
                    if d < bd then bd = d; best = p end
                end
            end
        end
        A360._target = best
        A360._shots = 0
    end
    if A360._target then
        local tr = A360._target.Character and A360._target.Character:FindFirstChild("HumanoidRootPart")
        local r = hrp()
        if tr and r and C.Auto360TurnBody then
            local d = tr.Position - r.Position
            local flat = Vector3.new(d.X, 0, d.Z)
            if flat.Magnitude > 0.1 then
                local yaw = math.atan2(-flat.X, -flat.Z)
                r.CFrame = CFrame.new(r.Position) * CFrame.Angles(0, yaw, 0)
            end
        end
        local head = A360._target.Character:FindFirstChild("Head")
        if head then aimTarget = head end
        if C.Auto360AutoShoot and tick() - A360._last >= C.Auto360FireRate then
            A360._last = tick()
            if A360._shots < C.Auto360MaxShots then
                A360._shots = A360._shots + 1
                if mouse1click then mouse1click() end
            else
                A360._shots = 0
            end
        end
    end
end)

