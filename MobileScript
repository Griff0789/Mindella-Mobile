-- ФИКС: стабильная камера без Roll
local function tpControl(dt)
    if not C.ThirdPerson then return end
    local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    -- Нормализация углов
    if TP._yaw > math.pi then TP._yaw = TP._yaw - 2*math.pi end
    if TP._yaw < -math.pi then TP._yaw = TP._yaw + 2*math.pi end
    TP._pitch = math.clamp(TP._pitch, math.rad(-70), math.rad(70))

    -- Позиция камеры строго сзади
    local distance = C.ThirdPersonDistance
    local height = C.ThirdPersonHeight

    -- Базовая позиция: сзади на distance с учётом yaw
    local offset = CFrame.Angles(0, TP._yaw, 0) * CFrame.new(0, height, distance)
    local targetPos = root.Position + offset.Position

    -- Точка взгляда: голова персонажа (фиксированная высота)
    local lookAt = root.Position + Vector3.new(0, 1.5, 0) + 
                   CFrame.Angles(0, TP._yaw, 0) * CFrame.new(0, 0, -10).Position * math.cos(TP._pitch)

    -- Строим CFrame без Roll — только yaw + pitch
    local baseCF = CFrame.new(targetPos, lookAt)
    local pitchCF = CFrame.Angles(TP._pitch * 0.5, 0, 0)  -- мягкий pitch без переворота
    local finalCF = baseCF * pitchCF

    if C.ThirdPersonSmooth then
        if not TP._cur then TP._cur = finalCF end
        TP._cur = TP._cur:Lerp(finalCF, math.min(1, 15 * dt))
        Camera.CFrame = TP._cur
    else
        TP._cur = finalCF
        Camera.CFrame = finalCF
    end
end

UIS.InputChanged:Connect(function(input, gpe)
    if gpe or not C.ThirdPerson then return end
    if input.UserInputType == Enum.UserInputType.Touch then
        local delta = input.Delta
        local sens = C.ThirdPersonSens * 0.005
        TP._yaw = TP._yaw - delta.X * sens
        TP._pitch = math.clamp(TP._pitch - delta.Y * sens, math.rad(-70), math.rad(70))
    end
end)

RunService.RenderStepped:Connect(function(dt)
    if not C.ThirdPerson then return end
    tpForce()
    tpHideBody()
    tpControl(dt)
end)

